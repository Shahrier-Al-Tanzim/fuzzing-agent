# .gitignore
planning/
planning-*.md
info.md


# Secrets - never commit
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.hypothesis/

# Build output
harness/build/
harness/vendor/
*.o
*.so
a.out

# Run artifacts
**/logs/*.jsonl
agent/state/
!**/logs/.gitkeep

# triage/reports/ is intentionally NOT ignored - it's the deduplicated,
# minimized, verified crash evidence report/ARTIFACTS.md points at as a
# deliverable, not disposable output like the raw logs above.

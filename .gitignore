# .gitignore
planning/
planning-*.md
info.md


# Secrets - never commit
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.hypothesis/

# Build output
harness/build/
harness/vendor/
*.o
*.so
a.out

# Run artifacts
**/logs/*.jsonl
agent/state/
!**/logs/.gitkeep

# triage/reports/ is intentionally NOT ignored - it's the deduplicated,
# minimized, verified crash evidence report/ARTIFACTS.md points at as a
# deliverable, not disposable output like the raw logs above.

# logs/RUN_HISTORY.* is intentionally NOT ignored either, same reason -
# it's the permanent, append-only attempt record, not disposable per-run
# output like pipeline/logs/*.jsonl. The **/logs/*.jsonl rule above would
# otherwise silently catch it since it also lives in a folder named logs/.
!logs/RUN_HISTORY.jsonl
!logs/RUN_HISTORY.md

explanation.md
